{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/checkout",
      "destination": "/api/checkout/status"
    },
    {
      "source": "/api/storage",
      "destination": "/api/storage/health"
    },
    {
      "source": "/api/support",
      "destination": "/api/support/health"
    },
    {
      "source": "/api/webhooks",
      "destination": "/api/webhooks/razorpay"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
