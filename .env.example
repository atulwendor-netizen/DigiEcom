# DigiEcom Environment Configuration Example
# Copy this file to .env for local configuration if needed.

# Frontend Configuration
VITE_APP_NAME=DigiEcom
VITE_APP_ENV=development
VITE_STORE_CURRENCY=INR
VITE_SUPPORT_EMAIL=digiecomsupport1@gmail.com

# Server Port
PORT=5001

# AI Customer Support Assistant (Server-Side Only - NEVER prefix with VITE_)
# Option A: Google Gemini API (Recommended)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Option B: OpenAI-Compatible API (OpenAI, Groq, Ollama, etc.)
# AI_API_KEY=your_openai_or_groq_api_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Note: If no AI keys are configured, DigiEcom automatically uses its built-in
# Grounded Catalogue & Policy Fallback Provider with full store knowledge.

# Future WhatsApp Business Platform Webhook Integration (Optional)
# WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
# WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here

# Razorpay Sandbox / Payment Gateway Configuration
# VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key
# RAZORPAY_KEY_SECRET=placeholder_secret_key
# VITE_ENABLE_RAZORPAY=false
