# DigiEcom Environment Configuration Example
# Copy this file to .env for local overrides if needed.
# Note: The initial release is a static storefront. No real API keys or payment secrets are required.

# App Config
VITE_APP_NAME=DigiEcom
VITE_APP_ENV=development
VITE_STORE_CURRENCY=INR

# Future Backend / Checkout API endpoint (Disabled in storefront preview)
# VITE_API_BASE_URL=https://api.yourdomain.com/v1

# Future Payment Provider Public Key placeholder (Disabled in storefront preview)
# VITE_PAYMENT_GATEWAY_KEY=pk_test_placeholder_key

# Razorpay Payment Gateway Configuration (Test Mode by default)
# VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key
# RAZORPAY_KEY_SECRET=placeholder_secret_key
# VITE_ENABLE_RAZORPAY=true

# Support Email placeholder
VITE_SUPPORT_EMAIL=support@example.com
